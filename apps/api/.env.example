APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://cloudfinops:cloudfinops@localhost:5433/cloudfinops
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_TENANT_SLUG=demo
ENCRYPTION_KEY=
AWS_MANAGEMENT_ACCOUNT_ID=000000000000
AWS_EXTERNAL_ID_PREFIX=cloudfinops
APP_BASE_URL=http://localhost:8000
MOCK_ADAPTERS=false
LLM_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_VERSION=2024-08-01-preview
LLM_PROVIDER_OVERRIDE=
LLM_MODEL_OVERRIDE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ITERATIONS=3
AUTH_DISABLED=false
JWT_SECRET=dev-insecure-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

DEMO_MODE=true
FRONTEND_BASE_URL=http://localhost:5173

WORKER_ENABLED=true
WORKER_QUEUE_NAME=cloudfinops
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_RESULT_TTL_SECONDS=3600

AUDIT_EXPORT_BACKEND=local
AUDIT_EXPORT_LOCAL_ROOT=exports
AUDIT_EXPORT_RETENTION_DAYS=30
AUDIT_EXPORT_MAX_RECORDS=100000

AUDIT_EXPORT_S3_BUCKET=
AUDIT_EXPORT_S3_PREFIX=audit
AUDIT_EXPORT_S3_REGION=
AUDIT_EXPORT_S3_ENDPOINT_URL=
AUDIT_EXPORT_S3_ACCESS_KEY_ID=
AUDIT_EXPORT_S3_SECRET_ACCESS_KEY=
AUDIT_EXPORT_SIGNED_URL_TTL_SECONDS=900

AUDIT_EXPORT_AZURE_CONTAINER=
AUDIT_EXPORT_AZURE_CONNECTION_STRING=
AUDIT_EXPORT_AZURE_ACCOUNT_URL=

OAUTH_ENABLED=false
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@cloudfinops.local
SMTP_STARTTLS=false

WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=2